# Server config
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (see docs/database-setup.md).
# The /learnify path segment pins collections to the `learnify` DB so we
# don't land in the default `admin` DB. Add this cluster's IP to the
# Atlas Network Access allowlist before running `npm run seed`.
MONGODB_URI=mongodb+srv://kenkaneki5414_db_user:x3r4Q21GxWxMGGkD@learnify-cluster.1jnlfzf.mongodb.net/learnify?retryWrites=true&w=majority&appName=learnify-cluster

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins; * to allow all)
CORS_ORIGINS=http://localhost:5173
