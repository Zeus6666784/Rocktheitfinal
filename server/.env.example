# Server config — copy to `.env` and fill in the values.

# Port the Express server listens on. Railway picks its own PORT at runtime;
# set this only for local development.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# The /learnify path segment pins collections to the `learnify` DB so we
# don't land in the default `admin` DB. Add this cluster's IP to the
# Atlas Network Access allowlist before running `npm run seed`.
#
# Get this from Atlas: Connect -> Drivers -> copy the SRV string,
# then fill in the password and append `/learnify` before the `?`.
MONGODB_URI=

# JWT signing secret. Use a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins). Use the Railway app URL after first deploy.
# For local dev use http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Admin token. Required to upload videos or patch lecture videoUrl via the
# admin endpoints. Same format as JWT_SECRET. Must be set BEFORE the first
# upload or no request will go through.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN=

# Trust proxy headers (Railway's load balancer). When set to 1, Express
# trusts X-Forwarded-* so req.ip is the real client IP behind the proxy.
TRUST_PROXY=1