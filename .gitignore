# Dependencies
node_modules/
package-lock.json

# Build / dist
dist/
build/

# Env (never commit secrets)
.env
.env.local
.env.*.local

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude worktrees (ephemeral dev sandboxes, not project content)
.claude/worktrees/

# Server runtime data: placeholders committed, everything else ignored.
# server/data/videos/ is the canonical (token-gated) storage location.
# Anything that's NOT one of the four placeholder filenames is uploaded
# at runtime and is therefore not for the repo.
server/data/videos/*
!server/data/videos/demo.mp4
!server/data/videos/react-usestate.mp4
!server/data/videos/react-useeffect.mp4
!server/data/videos/deep-work.mp4
!server/data/videos/INSTRUCTIONS.md

# Legacy uploads folder - was publicly served, no longer used.
server/uploads/

# PowerShell helper scripts (sandbox-only)
*.ps1

# Logs
*.log
npm-debug.log*
