# Dependencies
node_modules/
package-lock.json

# Build / dist
dist/
build/

# Env
.env
.env.local
.env.*.local

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude worktrees (ephemeral dev sandboxes, not project content)
.claude/worktrees/

# Server uploads (seeded at runtime)
server/uploads/resources/*
!server/uploads/resources/.gitkeep

# Server videos: placeholder MP4s are committed; user-uploaded ones are ignored.
server/uploads/videos/*.mp4
!server/uploads/videos/demo.mp4
!server/uploads/videos/react-usestate.mp4
!server/uploads/videos/react-useeffect.mp4
!server/uploads/videos/deep-work.mp4

# Logs
*.log
npm-debug.log*
